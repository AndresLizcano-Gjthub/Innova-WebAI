# Copia este archivo a ".env.local" (que Git ignora).
# CUIDADO: todo lo que empieza por NEXT_PUBLIC_ es PÚBLICO (viaja al navegador).
# Aquí NUNCA va una clave de API, solo URLs.

# URL del backend orquestador. Vacía = el frontend usa respuestas simuladas sin llamar al backend.
NEXT_PUBLIC_ORCHESTRATOR_URL=
