# Copia este archivo a ".env" (que Git ignora) y rellena los valores.
# NUNCA subas el ".env" real. Es como application-secrets.properties en Java.

# Modo de proveedores: "mock" (respuestas simuladas, por defecto) o "real".
PROVIDER_MODE=mock

# Orígenes del frontend permitidos por CORS, separados por comas.
ALLOWED_ORIGINS=http://localhost:3000

# Claves de proveedores: solo aquí o en los Secrets del hosting, nunca en el frontend.
# (Se irán añadiendo cuando existan proveedores reales.)
